{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/finance/**",
              "ui_kits/app/**",
              "ui_kits/site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Gilroy))/i]",
        "message": "Font not provided by the design system. Available: Gilroy."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|size|shape|tone|ring|status|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, src, size, shape, tone, ring, status."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:circle|square)$/]",
        "message": "<Avatar> shape must be one of 'circle' | 'square'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:mint|gold|violet|ink|blue)$/]",
        "message": "<Avatar> tone must be one of 'mint' | 'gold' | 'violet' | 'ink' | 'blue'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:online|away|off)$/]",
        "message": "<Avatar> status must be one of 'online' | 'away' | 'off'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|solid|dot|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, solid, dot."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|mint|gain|loss|warn|info|gold)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'mint' | 'gain' | 'loss' | 'warn' | 'info' | 'gold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|block|disabled|icon|iconRight|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, block, disabled, icon, iconRight."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|outline|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'outline' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|padding|glow|interactive|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, variant, padding, glow, interactive."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|elevated|glass|outline)$/]",
        "message": "<Card> variant must be one of 'default' | 'elevated' | 'glass' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Coin'] > JSXAttribute > JSXIdentifier[name!=/^(?:symbol|size|tone|spin|glow|key|ref|className|style|children)$/]",
        "message": "<Coin> doesn't accept that prop. Declared props: symbol, size, tone, spin, glow."
      },
      {
        "selector": "JSXOpeningElement[name.name='Coin'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:gold|mint|silver)$/]",
        "message": "<Coin> tone must be one of 'gold' | 'mint' | 'silver'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CreditCard3D'] > JSXAttribute > JSXIdentifier[name!=/^(?:scheme|label|tier|holder|last4|network|balance|width|interactive|float|key|ref|className|style|children)$/]",
        "message": "<CreditCard3D> doesn't accept that prop. Declared props: scheme, label, tier, holder, last4, network, balance, width, interactive, float."
      },
      {
        "selector": "JSXOpeningElement[name.name='CreditCard3D'] > JSXAttribute[name.name='scheme'] > Literal[value!=/^(?:obsidian|emerald|gold|violet)$/]",
        "message": "<CreditCard3D> scheme must be one of 'obsidian' | 'emerald' | 'gold' | 'violet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|prefix|suffix|size|containerStyle|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, error, prefix, suffix, size, containerStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Input> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|amount|amountTone|meta|avatarName|avatarSrc|avatarShape|avatarTone|leading|trailing|divider|key|ref|className|style|children)$/]",
        "message": "<ListRow> doesn't accept that prop. Declared props: title, subtitle, amount, amountTone, meta, avatarName, avatarSrc, avatarShape, avatarTone, leading, trailing, divider."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute[name.name='amountTone'] > Literal[value!=/^(?:default|gain|loss)$/]",
        "message": "<ListRow> amountTone must be one of 'default' | 'gain' | 'loss'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute[name.name='avatarShape'] > Literal[value!=/^(?:circle|square)$/]",
        "message": "<ListRow> avatarShape must be one of 'circle' | 'square'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute[name.name='avatarTone'] > Literal[value!=/^(?:mint|gold|violet|ink|blue)$/]",
        "message": "<ListRow> avatarTone must be one of 'mint' | 'gold' | 'violet' | 'ink' | 'blue'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressRing'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|size|thickness|tone|label|caption|key|ref|className|style|children)$/]",
        "message": "<ProgressRing> doesn't accept that prop. Declared props: value, max, size, thickness, tone, label, caption."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressRing'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:mint|gold|loss|blue|violet)$/]",
        "message": "<ProgressRing> tone must be one of 'mint' | 'gold' | 'loss' | 'blue' | 'violet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SegmentOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|delta|deltaTone|icon|accent|key|ref|className|style|children)$/]",
        "message": "<StatTile> doesn't accept that prop. Declared props: label, value, delta, deltaTone, icon, accent."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute[name.name='deltaTone'] > Literal[value!=/^(?:gain|loss|neutral)$/]",
        "message": "<StatTile> deltaTone must be one of 'gain' | 'loss' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|size|style|key|ref|className|style|children)$/]",
        "message": "<Toggle> doesn't accept that prop. Declared props: checked, onChange, disabled, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Toggle> size must be one of 'sm' | 'md'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
