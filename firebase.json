{
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "ignore": [
                "node_modules",
                ".git",
                "firebase-debug.log",
                "firebase-debug.*.log",
                "*.local"
            ],
            "predeploy": [
                "npm --prefix \"$RESOURCE_DIR\" run build"
            ]
        }
    ],
    "storage": {
        "rules": "storage.rules"
    },
    "hosting": {
        "public": "build/web",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    },
    "emulators": {
        "auth": {
            "port": 9099
        },
        "functions": {
            "port": 5001
        },
        "firestore": {
            "port": 8080
        },
        "storage": {
            "port": 9199
        },
        "hosting": {
            "port": 5000
        },
        "ui": {
            "enabled": true
        },
        "singleProjectMode": true
    },
    "flutter": {
        "platforms": {
            "android": {
                "default": {
                    "projectId": "hyperdynamics-loyalty",
                    "appId": "1:80499955330:android:b3abe275e9541fd4e9c69b",
                    "fileOutput": "android/app/google-services.json"
                }
            },
            "ios": {
                "default": {
                    "projectId": "hyperdynamics-loyalty",
                    "appId": "1:80499955330:ios:29b9971cb32c5714e9c69b",
                    "uploadDebugSymbols": false,
                    "fileOutput": "ios/Runner/GoogleService-Info.plist"
                }
            },
            "dart": {
                "lib/firebase_options.dart": {
                    "projectId": "hyperdynamics-loyalty",
                    "configurations": {
                        "android": "1:80499955330:android:b3abe275e9541fd4e9c69b",
                        "ios": "1:80499955330:ios:29b9971cb32c5714e9c69b",
                        "web": "1:80499955330:web:a13840d45e205382e9c69b"
                    }
                }
            }
        }
    }
}
